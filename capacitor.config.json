{
  "appId": "chat.rico.app",
  "appName": "Rico",
  "webDir": "public",
  "server": {
    "url": "https://ricomates.si",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "ricomates.si",
      "*.ricomates.si"
    ]
  },
  "backgroundColor": "#0f0e17",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0f0e17",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
